// Keeps Go and the base images current. The rules decide what merges by
// itself and what cuts a release; docs/development.md explains the flow.
// [bump version] in a commit body is what bump-version.yml looks for.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "assignees": ["minituff"],
  // Nothing merges unless the checks are green, and Renovate checks that
  // itself, so it doesn't depend on the branch protection settings.
  "automergeType": "pr",
  // Squash, so the commit on main carries [bump version] for bump-version.yml.
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "separateMinorPatch": true,
  // BuildKit and the SBOM scanner are images named in action inputs
  // (driver-opts, sbom), which no default manager reads. Version and digest
  // move together, like the base images in the Dockerfile.
  "customManagers": [
    {
      "customType": "regex",
      "description": "BuildKit and SBOM scanner images in the workflows",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "image=(?<depName>moby/buildkit):(?<currentValue>v[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
        "generator=(?<depName>docker/buildkit-syft-scanner):(?<currentValue>[0-9][^@\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  // The docs site's tools: docs-requirements.in names them, and
  // docs-requirements.txt pins them and their dependencies with hashes.
  // Renovate updates the .in and reruns the command at the top of the .txt.
  "pip-compile": {
    "managerFilePatterns": ["/^\\.github/docs-requirements\\.txt$/"]
  },
  "packageRules": [
    {
      // go.mod and the Dockerfile must move together: scripts/go-version-check.sh
      // fails CI while they differ. The two halves become available at
      // different times (the official image follows the Go release, and each
      // waits out its own minimumReleaseAge), so no PR is opened until both
      // are in it. Without that, Renovate opens the PR with one half and CI
      // fails on it until the other arrives.
      "description": "Go itself: one PR for go.mod and the build image, never half",
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "groupName": "go",
      "minimumGroupSize": 2
    },
    {
      // Standard library security fixes arrive only this way. A short wait,
      // because the official image takes a few hours to follow a Go release.
      "description": "Go patch releases merge and ship by themselves",
      "matchPackageNames": ["go", "golang"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "commitBody": "[bump version]"
    },
    {
      // Only the build stage uses this image, so a new digest with the same
      // Go version changes nothing that ships. Merge it, don't release it.
      "description": "Build image refresh: no release",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "schedule": ["* 0-5 * * 1"]
    },
    {
      // These files do ship, but the digest moves often, so a week's worth
      // goes out as one patch release instead of one each.
      "description": "Runtime image refresh: weekly, with a patch release",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["gcr.io/distroless/**"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "schedule": ["* 0-5 * * 1"],
      "commitBody": "[bump version]"
    },
    {
      // Actions run in release.yml with the rights to publish and attest, and
      // they don't ship, so nothing is lost by waiting. A week gives upstream
      // time to notice and pull a compromised release before it gets here.
      "description": "GitHub Actions: one PR, minimum seven days old",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "minimumReleaseAge": "7 days"
    },
    {
      // Workflows aren't in the image, so these never cut a release. Not
      // digest: actions are pinned by SHA to a version tag, so a new digest
      // for the same version means upstream moved the tag. A person checks
      // that before it runs with the release job's rights. The actions share
      // one PR, and it automerges only if every update in it may.
      "description": "GitHub Actions: minor and patch merge by themselves; a moved tag (digest only) waits for review",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      // These run in the job that publishes and signs the image, so a person
      // looks at every update, after the same week's wait as the actions.
      "description": "BuildKit and SBOM scanner: reviewed by hand, minimum seven days old",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["moby/buildkit", "docker/buildkit-syft-scanner"],
      "groupName": "buildkit",
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      // The output file is pip-compile's; reading it as a plain requirements
      // file too would open a second PR for every pin in it.
      "description": "Docs tools: only through pip-compile",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": [".github/docs-requirements.txt"],
      "enabled": false
    },
    {
      // The built site is published, install commands included, so a
      // person reviews these, after the same week's wait as the actions.
      "description": "Docs site tools: reviewed by hand, minimum seven days old",
      "matchManagers": ["pip-compile"],
      "minimumReleaseAge": "7 days",
      "automerge": false
    }
  ]
}
